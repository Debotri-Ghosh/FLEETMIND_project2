# Copy this file to .env and fill in real values. Never commit .env itself.

# ── PostgreSQL (used by docker-compose + backend) ────────────────────────
POSTGRES_USER=fleetmind
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fleetmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL must point at the hostname docker-compose resolves ('postgres').
# For running the backend outside Docker, use: postgresql://fleetmind:change_me@localhost:5432/fleetmind
DATABASE_URL=postgresql://fleetmind:change_me@postgres:5432/fleetmind

# ── Backend API ──────────────────────────────────────────────────────────
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── LLM narrative layer (fleetmind/agents/llm.py) ────────────────────────
# Optional. With no key the whole rule-based pipeline still runs -- predictions,
# risk scores, equipment flagging and auto-filed service requests are all
# deterministic Python. Only POST /service-requests/{id}/narrative needs this,
# and it returns a clear 503 without it.
# (The Azure OpenAI / Ollama entries that used to sit here were placeholders
# for a provider that was never wired up; Anthropic is the real one.)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── Kaggle API (only needed if pulling the CWRU mirror via kagglehub) ────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Federated learning simulation ────────────────────────────────────────
NUM_SIMULATED_DEPOTS=4          # one per CWRU load level: 0HP,1HP,2HP,3HP
FL_ROUNDS=20
FL_STRATEGY=fedavg              # fedavg | fedprox

# ── Auth ─────────────────────────────────────────────────────────────────
# NO default is baked into the code for this one, unlike DATABASE_URL: a
# well-known signing key would let anyone who has read this repository mint an
# admin token. Leave it unset and the API generates a random per-process
# secret (tokens then stop surviving a restart, and a warning is logged).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=720

# ── Misc ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

