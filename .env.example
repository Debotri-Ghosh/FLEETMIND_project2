# Copy this file to .env and fill in real values. Never commit .env itself.

# ── PostgreSQL (local Docker container) ─────────────────────────────────
POSTGRES_USER=fleetmind
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fleetmind
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://fleetmind:change_me@localhost:5432/fleetmind

# ── LLM provider (for the LangGraph diagnostic/risk agents) ─────────────
# Pick ONE route:
# (a) Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# (b) Free local model via Ollama instead (leave Azure vars blank if using this)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Kaggle API (only needed if pulling the CWRU mirror via kagglehub) ───
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Federated learning simulation ────────────────────────────────────────
NUM_SIMULATED_DEPOTS=4          # one per CWRU load level: 0HP,1HP,2HP,3HP
FL_ROUNDS=20
FL_STRATEGY=fedavg              # fedavg | fedprox

# ── Misc ──────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
