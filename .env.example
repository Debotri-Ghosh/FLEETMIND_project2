# Copy this file to .env and fill in real values. Never commit .env itself.

# ── PostgreSQL (used by docker-compose + backend) ────────────────────────
POSTGRES_USER=fleetmind
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fleetmind
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# DATABASE_URL must point at the hostname docker-compose resolves ('postgres').
# For running the backend outside Docker, use: postgresql://fleetmind:change_me@localhost:5432/fleetmind
DATABASE_URL=postgresql://fleetmind:change_me@postgres:5432/fleetmind

# ── Backend API ──────────────────────────────────────────────────────────
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ── Frontend ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://localhost:8000

# ── LLM provider (for the LangGraph diagnostic/risk agents) ──────────────
# Pick ONE route:
# (a) Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# (b) Free local model via Ollama instead (leave Azure vars blank if using this)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ── Kaggle API (only needed if pulling the CWRU mirror via kagglehub) ────
KAGGLE_USERNAME=
KAGGLE_KEY=

# ── Federated learning simulation ────────────────────────────────────────
NUM_SIMULATED_DEPOTS=4          # one per CWRU load level: 0HP,1HP,2HP,3HP
FL_ROUNDS=20
FL_STRATEGY=fedavg              # fedavg | fedprox

# ── Misc ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

